# Base URL of the Akarabo Image API (include the version segment).
# Backend default: http://localhost:8000/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional — override the dev-server port
VITE_PORT=5173

# Optional public JSON feed with image URLs (must allow browser CORS).
# Accepts an array or a { photos: [...] } object with url/src/imageUrl values.
VITE_CLIENT_PHOTOS_URL=

